<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= book.title %> - คลังสมอง KLANGSAMONG</title>
    <!-- Google Fonts: Prompt & Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-navy: #1E3A8A;
            --sky-blue: #38BDF8;
            --fresh-green: #22C55E;
            --green-hover: #16a34a;
            --sun-yellow: #FACC15;
            --bg-light: #F3F4F6;
            --text-dark: #1E293B;
            --text-muted: #64748B;
        }

        * { box-sizing: border-box; }
        body { font-family: 'Prompt', 'Kanit', sans-serif; background-color: var(--bg-light); color: var(--text-dark); margin: 0; padding: 0; }
        
        /* Header */
        header { background-color: var(--primary-navy); border-bottom: 1px solid rgba(255,255,255,0.1); padding: 12px 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 12px rgba(30,58,138,0.2); }
        .logo-area { text-decoration: none; display: flex; align-items: center; gap: 10px; color: white; }
        .logo-area img { height: 42px; border-radius: 6px; background: white; padding: 2px; }
        .logo-area h1 { margin: 0; font-size: 20px; font-weight: 700; }
        .user-nav { display: flex; align-items: center; gap: 12px; }
        .btn-header { background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 7px 16px; border-radius: 20px; text-decoration: none; font-size: 13.5px; font-weight: 600; transition: 0.2s; }
        .btn-header:hover { background: rgba(255,255,255,0.3); }

        /* Main Sub Page Container */
        .detail-container { max-width: 960px; margin: 30px auto; background: white; border-radius: 16px; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); position: relative; border: 1px solid #e2e8f0; }
        
        /* Badge Ribbon (Top Right) */
        .ribbon-container { position: absolute; top: 0; right: 35px; display: flex; flex-direction: column; align-items: center; }
        .ribbon-bestseller { background: #ef4444; color: white; font-size: 10px; font-weight: 800; text-align: center; padding: 6px 8px; line-height: 1.1; width: 44px; border-radius: 0 0 4px 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
        .ribbon-badge { background: var(--fresh-green); color: white; font-size: 10px; font-weight: 800; text-align: center; padding: 4px 8px; margin-top: 2px; width: 44px; border-radius: 0 0 4px 4px; }

        /* Book Title Header */
        .book-main-title { text-align: center; font-size: 24px; font-weight: 700; color: var(--primary-navy); margin-top: 5px; margin-bottom: 30px; line-height: 1.3; }

        /* Layout Grid */
        .detail-grid { display: flex; gap: 45px; align-items: flex-start; }
        .cover-wrapper { width: 300px; flex-shrink: 0; text-align: center; }
        .cover-img { width: 100%; border-radius: 12px; box-shadow: 0 8px 24px rgba(30, 58, 138, 0.15); object-fit: cover; border: 1px solid #e2e8f0; }

        /* Meta Information Right Side */
        .info-wrapper { flex-grow: 1; }
        .meta-line { font-size: 14.5px; margin-bottom: 12px; color: #334155; }
        .meta-line span.label { color: #64748b; width: 90px; display: inline-block; font-weight: 500; }
        .meta-line a { color: var(--primary-navy); text-decoration: none; font-weight: 600; }
        .meta-line a:hover { text-decoration: underline; }

        /* Action Buttons Row */
        .action-buttons { display: flex; gap: 15px; margin: 25px 0 20px 0; align-items: center; flex-wrap: wrap; }
        
        /* "ทดลองอ่าน" Button */
        .btn-sample { display: inline-flex; align-items: center; justify-content: center; width: 140px; padding: 11px 0; border: 2px solid var(--fresh-green); color: var(--fresh-green); background: white; border-radius: 25px; text-decoration: none; font-size: 15px; font-weight: 700; transition: all 0.2s; }
        .btn-sample:hover { background: #dcfce7; }

        /* "ดาวน์โหลด PDF" Button */
        .btn-buy-download { display: inline-flex; align-items: center; justify-content: center; min-width: 180px; padding: 12px 25px; background: var(--fresh-green); color: white; border-radius: 25px; text-decoration: none; font-size: 15px; font-weight: 700; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3); transition: transform 0.15s, background 0.2s; cursor: pointer; border: none; }
        .btn-buy-download:hover { background: var(--green-hover); transform: translateY(-2px); }

        /* Rating Row */
        .rating-row { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text-muted); margin-bottom: 20px; }
        .rating-score { color: #dc2626; font-weight: 700; }
        .stars { color: #f59e0b; letter-spacing: 2px; }

        /* Detail Metadata Table */
        .meta-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .meta-table td { padding: 10px 0; font-size: 13.5px; border-bottom: 1px dashed #e2e8f0; }
        .meta-table td.td-label { color: #64748b; width: 150px; font-weight: 500; }
        .meta-table td.td-val { color: #1e293b; text-align: right; font-weight: 600; }

        /* Description Section */
        .description-section { margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 25px; }
        .description-title { font-size: 17px; font-weight: 700; color: var(--primary-navy); margin-bottom: 12px; border-left: 4px solid var(--sky-blue); padding-left: 10px; }
        .description-text { font-size: 14.5px; line-height: 1.8; color: #334155; white-space: pre-line; }

        /* Login Modal */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; }
        .modal-overlay.active { display: flex; }
        .modal-box { background: white; border-radius: 14px; width: 90%; max-width: 400px; padding: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); position: relative; }
        .modal-close { position: absolute; top: 15px; right: 15px; border: none; background: none; font-size: 20px; cursor: pointer; color: #888; }
        .modal-title { font-size: 20px; font-weight: bold; margin-bottom: 15px; color: var(--primary-navy); text-align: center; }
        .form-field { margin-bottom: 15px; }
        .form-field label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 5px; color: #555; }
        .form-field input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; }
        .btn-submit { width: 100%; background: var(--fresh-green); color: white; border: none; padding: 12px; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; }
        .btn-submit:hover { background: var(--green-hover); }
        .quick-credentials { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 12px; margin-top: 15px; font-size: 12px; }
        .quick-credentials button { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; border-radius: 4px; padding: 4px 8px; margin-top: 4px; cursor: pointer; font-size: 11px; font-weight: bold; }

        @media (max-width: 768px) {
            .detail-container { padding: 20px; margin: 10px; }
            .detail-grid { flex-direction: column; align-items: center; gap: 25px; }
            .cover-wrapper { width: 220px; }
            .action-buttons { justify-content: center; }
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <a href="/" class="logo-area">
            <img src="/images/logo.png" alt="คลังสมอง KLANGSAMONG" onerror="this.style.display='none';">
            <h1>คลังสมอง KLANGSAMONG</h1>
        </a>
        <div class="user-nav">
            <a href="/" class="btn-header">← กลับหน้าหลัก</a>
            <% if (currentUser) { %>
                <a href="/logout" class="btn-header">ออกจากระบบ (<%= currentUser.username %>)</a>
            <% } else { %>
                <button class="btn-header" onclick="openLoginModal()">🔑 เข้าสู่ระบบ</button>
            <% } %>
        </div>
    </header>

    <!-- Main Container -->
    <div class="detail-container">
        
        <!-- Ribbon Badges -->
        <div class="ribbon-container">
            <div class="ribbon-bestseller">BEST<br>SELLER</div>
            <% if (book.badge) { %>
                <div class="ribbon-badge"><%= book.badge %></div>
            <% } %>
        </div>

        <!-- Book Title -->
        <h1 class="book-main-title"><%= book.title %></h1>

        <!-- Detail Grid -->
        <div class="detail-grid">
            
            <!-- Left Cover -->
            <div class="cover-wrapper">
                <img src="<%= book.cover_image_url || 'https://via.placeholder.com/300x400?text=No+Cover' %>" alt="<%= book.title %>" class="cover-img">
            </div>

            <!-- Right Information -->
            <div class="info-wrapper">
                
                <div class="meta-line">
                    <span class="label">หมวดหมู่:</span>
                    <a href="/?category=<%= encodeURIComponent(book.category) %>"><%= book.category || 'สมุดระบายสีเด็ก' %></a>
                </div>

                <div class="meta-line">
                    <span class="label">โดย:</span>
                    <strong><%= book.author_name || 'คลังสมอง' %></strong>
                </div>

                <div class="meta-line">
                    <span class="label">สำนักพิมพ์:</span>
                    <span><%= book.publisher || 'คลังสมอง KLANGSAMONG' %></span>
                </div>

                <!-- Rating -->
                <div class="rating-row">
                    <span class="rating-score">5.0</span>
                    <span class="stars">★★★★★</span>
                    <span>(เรตติ้งจากผู้เรียน)</span>
                </div>

                <!-- Action Buttons Row -->
                <div class="action-buttons">
                    <% if (book.sample_file_path) { %>
                        <a href="<%= book.sample_file_path %>" target="_blank" class="btn-sample">
                            👁️ ทดลองอ่าน
                        </a>
                    <% } else { %>
                        <button class="btn-sample" style="opacity: 0.6; cursor: not-allowed;" onclick="alert('ไม่มีไฟล์ตัวอย่างทดลองอ่านสำหรับเล่มนี้');">
                            👁️ ทดลองอ่าน
                        </button>
                    <% } %>

                    <% if (currentUser) { %>
                        <% if (book.file_path) { %>
                            <a href="<%= book.file_path %>" download class="btn-buy-download">
                                📥 ดาวน์โหลด PDF (฿<%= parseFloat(book.price).toFixed(0) %>)
                            </a>
                        <% } else { %>
                            <button class="btn-buy-download" style="opacity: 0.6; cursor: not-allowed;" onclick="alert('ไฟล์ PDF ฉบับเต็มยังไม่ได้ถูกอัปโหลด');">
                                📥 ดาวน์โหลด PDF
                            </button>
                        <% } %>
                    <% } else { %>
                        <button class="btn-buy-download" onclick="promptLoginForDownload()">
                            🔒 เข้าสู่ระบบเพื่อดาวน์โหลด PDF (฿<%= parseFloat(book.price).toFixed(0) %>)
                        </button>
                    <% } %>
                </div>

                <!-- Metadata Table -->
                <table class="meta-table">
                    <tr>
                        <td class="td-label">ประเภทไฟล์:</td>
                        <td class="td-val"><%= book.file_type || 'PDF' %></td>
                    </tr>
                    <tr>
                        <td class="td-label">จำนวนหน้า / ความยาว:</td>
                        <td class="td-val"><%= book.pages_count || '20 หน้า' %></td>
                    </tr>
                    <tr>
                        <td class="td-label">ราคาขาย:</td>
                        <td class="td-val" style="color: #dc2626; font-size: 16px;">
                            ฿<%= parseFloat(book.price).toFixed(0) %>
                            <% if (book.original_price && book.original_price > book.price) { %>
                                <span style="text-decoration: line-through; color: #94a3b8; font-size: 13px; margin-left: 6px;">
                                    ฿<%= parseFloat(book.original_price).toFixed(0) %>
                                </span>
                            <% } %>
                        </td>
                    </tr>
                </table>

            </div>

        </div>

        <!-- Description Section -->
        <div class="description-section">
            <div class="description-title">📖 เรื่องย่อ / รายละเอียดสื่อการเรียนรู้</div>
            <div class="description-text"><%= book.description || 'ไม่มีรายละเอียดเพิ่มเติมสำหรับสื่อรายการนี้' %></div>
        </div>

    </div>

    <!-- Login Modal -->
    <div class="modal-overlay" id="loginModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeLoginModal()">&times;</button>
            <div class="modal-title">กรุณาเข้าสู่ระบบเพื่อดาวน์โหลด</div>
            <p style="font-size: 13px; color: #64748b; text-align: center; margin-top: -10px; margin-bottom: 15px;">
                คุณต้องเข้าสู่ระบบสมาชิกก่อนจึงจะสามารถดาวน์โหลดไฟล์ PDF ได้
            </p>

            <form action="/login" method="POST">
                <div class="form-field">
                    <label>ชื่อผู้ใช้งาน (Username):</label>
                    <input type="text" name="username" id="loginUsername" required placeholder="กรอก username">
                </div>
                <div class="form-field">
                    <label>รหัสผ่าน (Password):</label>
                    <input type="password" name="password" id="loginPassword" required placeholder="กรอก password">
                </div>
                <button type="submit" class="btn-submit">เข้าสู่ระบบแล้วดาวน์โหลด</button>
            </form>

            <div class="quick-credentials">
                <strong>💡 ข้อมูลเข้าสู่ระบบทดสอบ (Demo Accounts):</strong><br>
                • <strong>User:</strong> username: <code>user</code> | password: <code>user123</code>
                <button onclick="fillLogin('user', 'user123')">เติมข้อมูล User</button><br>
                • <strong>Admin:</strong> username: <code>admin</code> | password: <code>admin123</code>
                <button onclick="fillLogin('admin', 'admin123')">เติมข้อมูล Admin</button>
            </div>
        </div>
    </div>

    <script>
        function openLoginModal() {
            document.getElementById('loginModal').classList.add('active');
        }
        function closeLoginModal() {
            document.getElementById('loginModal').classList.remove('active');
        }
        function promptLoginForDownload() {
            openLoginModal();
        }
        function fillLogin(u, p) {
            document.getElementById('loginUsername').value = u;
            document.getElementById('loginPassword').value = p;
        }
    </script>
</body>
</html>
