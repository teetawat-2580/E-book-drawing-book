        async function handleVisualSubmit(e) {
            if (e && e.preventDefault) e.preventDefault();
            const submitBtn = document.getElementById('btnSaveBatch');

            const selectedRows = document.querySelectorAll('#tableBody tr:not([style*="display: none"]) .v-select-row:checked');
            if (selectedRows.length === 0) {
                alert('⚠️ กรุณาติ๊กเลือกช่องด้านหน้าอย่างน้อย 1 รายการที่ต้องการบันทึกข้อมูล');
                return false;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = '⏳ กำลังบันทึกรายการที่เลือก (Chunked)...';

            try {
                const data = [];
                selectedRows.forEach(cb => {
                    const tr = cb.closest('tr');
                    const getVal = (selector) => {
                        const el = tr.querySelector(selector);
                        return el ? el.value : '';
                    };

                    const id = getVal('.v-id');
                    const title = getVal('.v-title');
                    const author = getVal('.v-author');
                    const publisher = getVal('.v-publisher');
                    const category = getVal('.v-category');
                    const price = getVal('.v-price');
                    const originalPrice = getVal('.v-original-price');
                    const pages = getVal('.v-pages');
                    const fileType = getVal('.v-file-type');
                    const badge = getVal('.v-badge');
                    const cover = getVal('.v-cover');
                    const bookFile = getVal('.v-book-file');
                    const sampleFile = getVal('.v-sample-file');
                    const description = getVal('.v-description');

                    if (title && title.trim()) {
                        data.push({
                            id: id ? parseInt(id) : null,
                            title: title,
                            author_name: author,
                            publisher: publisher,
                            category: category,
                            price: parseFloat(price) || 0,
                            original_price: originalPrice ? parseFloat(originalPrice) : null,
                            pages_count: pages,
                            file_type: fileType,
                            badge: badge,
                            cover_image_url: cover,
                            file_path: bookFile,
                            sample_file_path: sampleFile,
                            description: description
                        });
                    }
                });

                if (data.length === 0) {
                    alert('ไม่มีข้อมูลที่ถูกต้องในการบันทึก');
                    submitBtn.disabled = false;
                    updateSelectedCount();
                    return false;
                }

                // Chunk batch submit into groups of 5 books per request
                const BATCH_SIZE = 5;
                for (let i = 0; i < data.length; i += BATCH_SIZE) {
                    const chunk = data.slice(i, i + BATCH_SIZE);
                    const pct = Math.round(((i + chunk.length) / data.length) * 100);
                    submitBtn.textContent = '⏳ กำลังบันทึกรายการที่เลือก (' + pct + '%)...';

                    const res = await fetch('/admin/batch-update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ books: chunk })
                    });

                    if (!res.ok) {
                        const errText = await res.text();
                        throw new Error('บันทึกผิดพลาดที่รายการที่ ' + (i + 1) + ' (HTTP ' + res.status + ')');
                    }
                }

                // Generate SQL Code string for the updated/inserted records
                const generatedSql = generateSqlQueries(data);
                showSqlModal(generatedSql, data.length);

            } catch (err) {
                alert('เกิดข้อผิดพลาดในการบันทึก: ' + err.message);
                submitBtn.disabled = false;
                updateSelectedCount();
            }
            return false;
        }

        function generateSqlQueries(data) {
            const esc = (val) => (val === null || val === undefined || val === '') ? 'NULL' : `'${String(val).replace(/'/g, "''")}'`;
            const num = (val) => (val === null || val === undefined || val === '' || isNaN(val)) ? 'NULL' : val;

            return data.map(b => {
                if (b.id) {
                    return `UPDATE books SET title = ${esc(b.title)}, author_name = ${esc(b.author_name)}, publisher = ${esc(b.publisher)}, category = ${esc(b.category)}, price = ${num(b.price)}, original_price = ${num(b.original_price)}, pages_count = ${esc(b.pages_count)}, file_type = ${esc(b.file_type)}, badge = ${esc(b.badge)}, cover_image_url = ${esc(b.cover_image_url)}, file_path = ${esc(b.file_path)}, sample_file_path = ${esc(b.sample_file_path)}, description = ${esc(b.description)} WHERE id = ${b.id};`;
                } else {
                    return `INSERT INTO books (title, author_name, publisher, category, price, original_price, pages_count, file_type, badge, cover_image_url, file_path, sample_file_path, description) VALUES (${esc(b.title)}, ${esc(b.author_name)}, ${esc(b.publisher)}, ${esc(b.category)}, ${num(b.price)}, ${num(b.original_price)}, ${esc(b.pages_count)}, ${esc(b.file_type)}, ${esc(b.badge)}, ${esc(b.cover_image_url)}, ${esc(b.file_path)}, ${esc(b.sample_file_path)}, ${esc(b.description)});`;
                }
            }).join('\n\n');
        }

        function showSqlModal(sql, count) {
            let modal = document.getElementById('sqlOutputModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'sqlOutputModal';
                modal.style.cssText = 'position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.7); z-index:9999; display:flex; justify-content:center; align-items:center; backdrop-filter:blur(4px);';
                modal.innerHTML = `
                    <div style="background:white; border-radius:14px; padding:24px 28px; max-width:850px; width:92%; max-height:88vh; overflow-y:auto; box-shadow:0 20px 40px rgba(0,0,0,0.3); border:1.5px solid #e2e8f0;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                            <h3 style="margin:0; color:#1e3a8a; font-size:18px; display:flex; align-items:center; gap:8px;">
                                <span>⚡</span> โค้ด SQL ที่เกิดขึ้นจากการบันทึก (<span id="sqlCountLabel">0</span> รายการ)
                            </h3>
                            <button type="button" onclick="closeSqlModalAndReload()" style="border:none; background:none; font-size:20px; cursor:pointer; color:#64748b;">✕</button>
                        </div>
                        <p style="font-size:13px; color:#475569; margin-bottom:12px; line-height:1.5;">
                            ✅ บันทึกลงฐานข้อมูลเรียบร้อยแล้ว! สามารถก๊อปปี้โค้ด SQL ด้านล่างนี้ไปเก็บสำรอง หรือเอาไปรันต่อในช่อง <strong>⚡ SQL Code Batch Execution</strong> ได้ทันที:
                        </p>
                        <textarea id="sqlResultTextarea" style="width:100%; height:280px; font-family:Consolas, Monaco, monospace; font-size:12.5px; padding:12px; border-radius:8px; border:1.5px solid #cbd5e1; background:#f8fafc; color:#0f172a; line-height:1.4; resize:vertical;" readonly></textarea>
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
                            <button type="button" onclick="copyGeneratedSql()" style="background:#22c55e; color:white; border:none; padding:10px 20px; border-radius:8px; font-weight:700; cursor:pointer; font-size:13.5px; display:flex; align-items:center; gap:6px;">
                                📋 คัดลอกโค้ด SQL (Copy SQL)
                            </button>
                            <button type="button" onclick="closeSqlModalAndReload()" style="background:#0284c7; color:white; border:none; padding:10px 20px; border-radius:8px; font-weight:700; cursor:pointer; font-size:13.5px;">
                                ตกลง / รีโหลดหน้าเว็บ
                            </button>
                        </div>
                    </div>
                `;
                document.body.appendChild(modal);
            }
            document.getElementById('sqlCountLabel').textContent = count;
            document.getElementById('sqlResultTextarea').value = sql;
            modal.style.display = 'flex';
        }

        function copyGeneratedSql() {
            const textarea = document.getElementById('sqlResultTextarea');
            textarea.select();
            document.execCommand('copy');
            alert('📋 คัดลอกโค้ด SQL ทั้งหมดลง Clipboard เรียบร้อยแล้ว!');
        }

        function closeSqlModalAndReload() {
            window.location.href = '/admin/batch?success=' + encodeURIComponent('บันทึกข้อมูลเรียบร้อยแล้ว');
        }

        document.addEventListener('DOMContentLoaded', filterBatchTable);
    </script>
</body>
</html>
