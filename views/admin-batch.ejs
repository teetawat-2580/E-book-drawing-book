        // Direct Firebase Storage / Fallback Upload function for table cells
        async function uploadRowFile(fileInput, subFolder, hiddenInputClass) {
            if (!fileInput.files || fileInput.files.length === 0) return;

            const file = fileInput.files[0];
            const td = fileInput.closest('td');
            const hiddenInput = td.querySelector('.' + hiddenInputClass);
            const statusEl = td.querySelector('.status-indicator');

            statusEl.innerHTML = '<span style="color:#d97706; font-size:11px; font-weight:bold;">⏳ กำลังอัปโหลด...</span>';

            try {
                let fileUrl = '';

                // 1. Direct Firebase Storage Upload (Physical file uploaded directly to Firebase Storage CDN)
                if (window.firebaseStorageUpload) {
                    try {
                        fileUrl = await window.firebaseStorageUpload(file, subFolder, (pct) => {
                            statusEl.innerHTML = `<span style="color:#d97706; font-size:11px; font-weight:bold;">⏳ ${pct}%</span>`;
                        });
                    } catch (err) {
                        console.error('Firebase Storage direct upload error in batch cell:', err);
                        statusEl.innerHTML = '<span style="color:#dc2626; font-size:11px; font-weight:bold;">❌ อัปโหลดล้มเหลว</span>';
                        alert('⚠️ ไม่สามารถอัปโหลดไปยัง Firebase Storage ได้!\n\nสาเหตุ: ' + err.message + '\n\n💡 วิธีแก้ไข:\n1. เข้า Firebase Console (https://console.firebase.google.com)\n2. ไปที่เมนู Build -> Storage -> คลิก Get Started\n3. ที่แท็บ Rules ให้ตั้งค่าเป็น:\n   allow read, write: if true;\n4. กด Publish');
                        return;
                    }
                }

                // 2. Try Vercel Blob Client Upload if configured
                if (!fileUrl && window.vercelBlobUpload) {
                    try {
                        const cleanFileName = file.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                        const blob = await window.vercelBlobUpload(subFolder + '/' + Date.now() + '-' + cleanFileName, file, {
                            access: 'public',
                            handleUploadUrl: '/api/upload/handle-client-upload'
                        });
                        fileUrl = blob.url;
                    } catch (err) {
                        console.warn('Direct blob client upload fallback:', err);
                    }
                }

                if (!fileUrl) {
                    // Chunked Upload Fallback
                    const CHUNK_SIZE = 2 * 1024 * 1024;
                    const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
                    const uploadId = 'up_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);

                    for (let i = 0; i < totalChunks; i++) {
                        const start = i * CHUNK_SIZE;
                        const end = Math.min(file.size, start + CHUNK_SIZE);
                        const chunkBlob = file.slice(start, end);

                        const base64Data = await new Promise((resolve, reject) => {
                            const reader = new FileReader();
                            reader.onload = () => resolve(reader.result.substring(reader.result.indexOf(',') + 1));
                            reader.onerror = reject;
                            reader.readAsDataURL(chunkBlob);
                        });

                        const pct = Math.round(((i + 1) / totalChunks) * 100);
                        statusEl.innerHTML = `<span style="color:#d97706; font-size:11px; font-weight:bold;">⏳ อัปโหลด (${pct}%)...</span>`;

                        const response = await fetch('/api/upload-chunk', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                uploadId: uploadId,
                                chunkIndex: i,
                                totalChunks: totalChunks,
                                filename: file.name,
                                subFolder: subFolder,
                                mimeType: file.type || 'application/pdf',
                                chunkData: base64Data
                            })
                        });

                        const resultText = await response.text();
                        const result = JSON.parse(resultText);
                        if (result.file_url) {
                            fileUrl = result.file_url;
                        }
                    }
                }

                hiddenInput.value = fileUrl;
                statusEl.innerHTML = `<span style="color:#16a34a; font-size:11px; font-weight:bold;">✅ อัปโหลดทับสำเร็จ!</span> <a href="${fileUrl}" target="_blank" style="color:#0284c7; font-size:11px; text-decoration:none;">👁️ เปิดดู</a>`;
            } catch (err) {
                statusEl.innerHTML = `<span style="color:#dc2626; font-size:11px; font-weight:bold;">❌ อัปโหลดผิดพลาด: ${err.message}</span>`;
                console.error(err);
            }
        }
        const DB_BOOKS = JSON.parse(decodeURIComponent('<%= encodeURIComponent(JSON.stringify(books || [])) %>'));

        function fillSqlDemo() {
            if (!DB_BOOKS || DB_BOOKS.length === 0) {
                const fallbackSql = `-- คำสั่งตัวอย่างกรณีไม่มีข้อมูลใน DB:
INSERT INTO books (title, author_name, publisher, category, price, original_price, pages_count, file_type, badge, file_path, description)
VALUES 
('ตัวอย่างสื่อการเรียนรู้ 1', 'คลังสมอง', 'คลังสมอง KLANGSOMONG', 'พื้นฐานการบวกเลข', 159.00, 199.00, '20 หน้า', 'PDF', 'แนะนำ', 'https://drive.google.com/file/d/demo1/view', 'รายละเอียดสื่อ...');`;
                document.getElementById('sqlQueryInput').value = fallbackSql;
                return;
            }

            const sampleBooks = DB_BOOKS.slice(0, 3);
            const esc = (val) => (val === null || val === undefined || val === '') ? 'NULL' : `'${String(val).replace(/'/g, "''")}'`;
            const num = (val) => (val === null || val === undefined || val === '' || isNaN(val)) ? 'NULL' : val;

            let sqlLines = [`-- ✨ คำสั่ง SQL ตัวอย่าง อ้างอิงตามโครงสร้างและข้อมูลจริงในฐานข้อมูลปัจจุบัน (${DB_BOOKS.length} เล่ม):`];

            sampleBooks.forEach((b, idx) => {
                sqlLines.push(`-- 1. ตัวอย่างคำสั่ง UPDATE รายการ ID: ${b.id}`);
                sqlLines.push(`UPDATE books SET title = ${esc(b.title)}, price = ${num(b.price)}, category = ${esc(b.category)} WHERE id = ${b.id};`);
            });

            sqlLines.push(`\n-- 2. ตัวอย่างคำสั่ง INSERT เล่มใหม่:`);
            sqlLines.push(`INSERT INTO books (title, author_name, publisher, category, price, original_price, pages_count, file_type, badge, file_path, description) VALUES ('สื่อการเรียนรู้ใหม่ (ตัวอย่าง)', 'คลังสมอง', 'คลังสมอง KLANGSOMONG', 'พื้นฐานการบวกเลข', 159.00, 199.00, '25 หน้า', 'PDF', 'มาใหม่', 'https://drive.google.com/file/d/sample/view', 'รายละเอียด...');`);

            document.getElementById('sqlQueryInput').value = sqlLines.join('\n');
        }

        function exportFullBooksSql() {
            if (!DB_BOOKS || DB_BOOKS.length === 0) {
                alert('⚠️ ไม่พบข้อมูลหนังสือใน Database ที่จะ Export');
                return;
            }

            const esc = (val) => {
                if (val === null || val === undefined || val === '') return 'NULL';
                const str = String(val);
                if (str.startsWith('data:')) return 'NULL';
                return `'${str.replace(/'/g, "''")}'`;
            };
            const num = (val) => (val === null || val === undefined || val === '' || isNaN(val)) ? 'NULL' : val;

            let sqlLines = [
                `-- 📥 โค้ด SQL ส่งออกหนังสือทั้งหมดในฐานข้อมูล (จำนวนทั้งหมด ${DB_BOOKS.length} รายการ)`,
                `-- แหล่งที่มา: KLANGSAMONG (klangsamong.vercel.app)`,
                `-- วันที่ส่งออก: ${new Date().toLocaleString('th-TH')}`,
                `-- ท่านสามารถนำไฟล์นี้ไปปรับแต่งข้อความ แล้วรันอัปเดตแบบ Batch ได้ทันที\n`
            ];

            DB_BOOKS.forEach(b => {
                const query = `INSERT INTO books (id, title, author_name, publisher, category, price, original_price, pages_count, file_type, badge, cover_image_url, file_path, sample_file_path, description) ` +
                              `VALUES (${b.id}, ${esc(b.title)}, ${esc(b.author_name)}, ${esc(b.publisher)}, ${esc(b.category)}, ${num(b.price)}, ${num(b.original_price)}, ${esc(b.pages_count)}, ${esc(b.file_type)}, ${esc(b.badge)}, ${esc(b.cover_image_url)}, ${esc(b.file_path)}, ${esc(b.sample_file_path)}, ${esc(b.description)}) ` +
                              `ON DUPLICATE KEY UPDATE title = VALUES(title), author_name = VALUES(author_name), publisher = VALUES(publisher), category = VALUES(category), price = VALUES(price), original_price = VALUES(original_price), pages_count = VALUES(pages_count), file_type = VALUES(file_type), badge = VALUES(badge), cover_image_url = VALUES(cover_image_url), file_path = VALUES(file_path), sample_file_path = VALUES(sample_file_path), description = VALUES(description);`;
                sqlLines.push(query);
            });

            const fullSql = sqlLines.join('\n\n');

            // Force browser native Save/Download file dialog window
            const today = new Date().toISOString().slice(0, 10);
            const fileName = `klangsamong_books_export_${today}.sql`;
            const blob = new Blob([fullSql], { type: 'application/octet-stream' });
            const url = URL.createObjectURL(blob);

            const link = document.createElement('a');
            link.href = url;
            link.setAttribute('download', fileName);
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();

            setTimeout(() => {
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            }, 1000);
        }

