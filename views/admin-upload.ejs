<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - อัปโหลดสื่อการเรียนรู้ | คลังสมอง KLANGSAMONG</title>
    <!-- Google Fonts: Prompt & Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-navy: #1E3A8A;
            --sky-blue: #38BDF8;
            --fresh-green: #22C55E;
            --green-hover: #16a34a;
            --sun-yellow: #FACC15;
            --bg-light: #F3F4F6;
            --text-dark: #1E293B;
        }

        * { box-sizing: border-box; }
        body { font-family: 'Prompt', 'Kanit', sans-serif; background-color: var(--bg-light); margin: 0; padding: 30px 15px; color: var(--text-dark); }
        .form-container { max-width: 680px; background: white; padding: 35px; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin: auto; border: 1px solid #e2e8f0; }
        h2 { color: var(--primary-navy); margin-top: 0; font-size: 21px; border-bottom: 2px solid #e2e8f0; padding-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .form-group { margin-bottom: 18px; }
        .form-row { display: flex; gap: 15px; }
        .form-row .form-group { flex: 1; }
        label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13.5px; color: #334155; }
        input[type="text"], input[type="number"], select, textarea, input[type="file"] { width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box; font-size: 14px; font-family: inherit; }
        textarea { height: 90px; resize: vertical; }
        button { background-color: var(--fresh-green); color: white; border: none; padding: 13px 20px; font-size: 16px; font-weight: 700; border-radius: 8px; cursor: pointer; width: 100%; margin-top: 10px; transition: background 0.2s; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3); font-family: inherit; }
        button:hover { background-color: var(--green-hover); }
        button:disabled { background-color: #94a3b8; cursor: not-allowed; box-shadow: none; }
        .back-link { display: inline-block; margin-top: 18px; color: #64748b; text-decoration: none; font-size: 14px; text-align: center; width: 100%; font-weight: 500; }
        .back-link:hover { color: var(--primary-navy); text-decoration: underline; }
        .section-tag { font-weight: 700; color: var(--primary-navy); margin: 22px 0 12px 0; border-left: 4px solid var(--sky-blue); padding-left: 10px; font-size: 15px; }
        .upload-status-box { display: none; background: #e0f2fe; border: 1px solid #7dd3fc; color: #0369a1; padding: 12px; border-radius: 8px; margin-top: 15px; font-size: 14px; font-weight: 600; text-align: center; }
    </style>
</head>
<body>

    <div class="form-container">
        <h2>➕ อัปโหลดสื่อการเรียนรู้ใหม่ (คลังสมอง KLANGSAMONG)</h2>
        
        <form id="uploadForm" action="/admin/upload-direct" method="POST">
            
            <input type="hidden" name="cover_image_url" id="cover_image_url">
            <input type="hidden" name="file_path" id="file_path">
            <input type="hidden" name="sample_file_path" id="sample_file_path">

            <div class="section-tag">ข้อมูลสื่อการเรียนรู้</div>

            <div class="form-group">
                <label>หมวดหมู่สื่อ (Category):</label>
                <select name="category" required>
                    <option value="สมุดระบายสีเด็ก">✏️ สมุดระบายสีเด็ก</option>
                    <option value="คณิตศาสตร์">🔢 ชีทคณิตศาสตร์</option>
                    <option value="พื้นฐานการบวกเลข">➕ พื้นฐานการบวกเลข</option>
                    <option value="ชีทฝึกเขียน">✍️ ชีทฝึกเขียนภาษา</option>
                    <option value="แฟลชการ์ด">🎴 แฟลชการ์ด 2 ภาษา</option>
                    <option value="เกมฝึกสมอง">🧩 เกมฝึกสมองเด็ก</option>
                    <option value="นิทานเด็ก AI">📚 นิทานและแบบเรียน</option>
                    <option value="สื่อครูตกแต่ง">🏫 สื่อครูตกแต่งห้องเรียน</option>
                </select>
            </div>

            <div class="form-group">
                <label>ชื่อสื่อการเรียนรู้ / เล่ม (Title):</label>
                <input type="text" name="title" required placeholder="เช่น เล่ม 1 : สัตว์แสนรัก (สมุดระบายสี)">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>ผู้จัดทำ (Author Name):</label>
                    <input type="text" name="author_name" placeholder="คลังสมอง">
                </div>
                <div class="form-group">
                    <label>สำนักพิมพ์ (Publisher):</label>
                    <input type="text" name="publisher" placeholder="คลังสมอง KLANGSAMONG">
                </div>
            </div>

            <div class="form-group">
                <label>รายละเอียด / คำอธิบาย (Description):</label>
                <textarea name="description" placeholder="รายละเอียดเนื้อหาในสื่อการเรียนรู้..."></textarea>
            </div>

            <div class="section-tag">การตั้งราคา & ข้อมูลเพิ่มเติม</div>

            <div class="form-row">
                <div class="form-group">
                    <label>ราคาขายจริง (Price THB):</label>
                    <input type="number" step="0.01" name="price" required placeholder="เช่น 159">
                </div>
                <div class="form-group">
                    <label>ราคาปกติ (Original Price THB - optional):</label>
                    <input type="number" step="0.01" name="original_price" placeholder="เช่น 199">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>ความยาว (Pages / Words):</label>
                    <input type="text" name="pages_count" placeholder="เช่น 20 หน้า">
                </div>
                <div class="form-group">
                    <label>ประเภทไฟล์ (File Format):</label>
                    <input type="text" name="file_type" value="PDF">
                </div>
            </div>

            <div class="form-group">
                <label>ป้ายกำกับพิเศษ (Badge / Tag):</label>
                <input type="text" name="badge" placeholder="เช่น เล่มยอดฮิต, แนะนำ">
            </div>

            <div class="section-tag">อัปโหลดไฟล์ (Direct Client Upload - ไม่จำกัดขนาด 4.5MB)</div>

            <div class="form-group">
                <label>🖼️ รูปภาพปกสื่อ (Cover Image):</label>
                <input type="file" id="cover_file_input" accept="image/*" required>
            </div>

            <div class="form-group">
                <label>📖 ไฟล์ PDF ฉบับเต็ม (Full PDF File):</label>
                <input type="file" id="book_file_input" accept=".pdf" required>
            </div>

            <div class="form-group" style="background: #f0fdf4; padding: 14px; border-radius: 8px; border: 1px dashed var(--fresh-green);">
                <label style="color: #15803d;">📄 ไฟล์ตัวอย่างสำหรับ "ทดลองอ่าน" (Sample Preview PDF):</label>
                <input type="file" id="sample_file_input" accept=".pdf">
                <small style="color: #64748b; display: block; margin-top: 4px;">* ไฟล์ PDF ตัวอย่างฉบับสั้นสำหรับปุ่ม "ทดลองอ่าน"</small>
            </div>

            <div class="upload-status-box" id="uploadStatus">
                ⏳ กำลังส่งไฟล์ตรงไปยัง Vercel Storage...
            </div>

            <button type="submit" id="submitBtn">🚀 อัปโหลดสื่อขึ้นระบบ คลังสมอง</button>
        </form>
        <a href="/admin/manage" class="back-link">← กลับไปหน้าระบบจัดการสื่อ</a>
    </div>

    <!-- Import Vercel Blob Client Module -->
    <script type="module">
        import { upload } from 'https://esm.sh/@vercel/blob/client';
        window.vercelBlobUpload = upload;
    </script>

    <script>
        async function directUploadFile(file, subFolder) {
            if (!file) return '';
            
            // Try Client-side Vercel Blob Direct Upload (Bypasses 4.5MB Serverless Payload Limit!)
            if (window.vercelBlobUpload) {
                try {
                    const cleanFileName = file.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                    const blob = await window.vercelBlobUpload(subFolder + '/' + Date.now() + '-' + cleanFileName, file, {
                        access: 'public',
                        handleUploadUrl: '/api/upload/handle-client-upload'
                    });
                    if (blob && blob.url) {
                        return blob.url;
                    }
                } catch (err) {
                    console.warn('Vercel blob direct client upload skipped/failed, using fallback:', err);
                }
            }

            // Fallback via server AJAX if blob token unavailable
            const formData = new FormData();
            formData.append('file', file);
            formData.append('subFolder', subFolder);

            const res = await fetch('/api/upload-file', {
                method: 'POST',
                body: formData
            });
            
            const resText = await res.text();
            let data;
            try {
                data = JSON.parse(resText);
            } catch (e) {
                if (res.status === 413 || resText.includes('Payload Too Large') || resText.includes('Request Entity')) {
                    throw new Error('ไฟล์ "' + file.name + '" มีขนาดใหญ่เกินข้อจำกัด 4.5MB ของ Vercel (กรุณาตั้งค่า BLOB_READ_WRITE_TOKEN ใน Vercel เพื่อเปิดใช้อัปโหลดขนาดใหญ่ไม่จำกัด)');
                }
                throw new Error('ข้อผิดพลาดจากเซิร์ฟเวอร์ (HTTP ' + res.status + ')');
            }

            if (data && data.success && data.file_url) {
                return data.file_url;
            } else {
                throw new Error(data ? data.message : 'File upload failed');
            }
        }

        document.getElementById('uploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submitBtn');
            const statusBox = document.getElementById('uploadStatus');

            submitBtn.disabled = true;
            statusBox.style.display = 'block';

            try {
                const coverFile = document.getElementById('cover_file_input').files[0];
                const bookFile = document.getElementById('book_file_input').files[0];
                const sampleFile = document.getElementById('sample_file_input').files[0];

                if (coverFile) {
                    statusBox.innerHTML = '⏳ กำลังอัปโหลดรูปภาพปก...';
                    document.getElementById('cover_image_url').value = await directUploadFile(coverFile, 'covers');
                }

                if (bookFile) {
                    statusBox.innerHTML = '⏳ กำลังอัปโหลดไฟล์ PDF ฉบับเต็ม (Direct Blob Upload)...';
                    document.getElementById('file_path').value = await directUploadFile(bookFile, 'books');
                }

                if (sampleFile) {
                    statusBox.innerHTML = '⏳ กำลังอัปโหลดไฟล์ PDF ตัวอย่าง...';
                    document.getElementById('sample_file_path').value = await directUploadFile(sampleFile, 'samples');
                }

                statusBox.innerHTML = '✅ อัปโหลดไฟล์เรียบร้อยแล้ว กำลังบันทึกข้อมูล...';
                this.submit();
            } catch (err) {
                alert('เกิดข้อผิดพลาดในการอัปโหลดไฟล์: ' + err.message);
                statusBox.style.display = 'none';
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>