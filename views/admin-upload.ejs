<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - อัปโหลดสื่อการเรียนรู้ | คลังสมอง KLANGSAMONG</title>
    <!-- Google Fonts: Prompt & Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Vercel Web Analytics -->
    <script>
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>

    <style>
        :root {
            --primary-navy: #1E3A8A;
            --sky-blue: #38BDF8;
            --fresh-green: #22C55E;
            --green-hover: #16a34a;
            --sun-yellow: #FACC15;
            --bg-light: #F3F4F6;
            --text-dark: #1E293B;
        }

        * { box-sizing: border-box; }
        body { font-family: 'Prompt', 'Kanit', sans-serif; background-color: var(--bg-light); margin: 0; padding: 30px 15px; color: var(--text-dark); }
        .form-container { max-width: 680px; background: white; padding: 35px; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin: auto; border: 1px solid #e2e8f0; }
        h2 { color: var(--primary-navy); margin-top: 0; font-size: 21px; border-bottom: 2px solid #e2e8f0; padding-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .form-group { margin-bottom: 18px; }
        .form-row { display: flex; gap: 15px; }
        .form-row .form-group { flex: 1; }
        label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13.5px; color: #334155; }
        input[type="text"], input[type="number"], select, textarea, input[type="file"] { width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; box-sizing: border-box; font-size: 14px; font-family: inherit; }
        textarea { height: 90px; resize: vertical; }
        button { background-color: var(--fresh-green); color: white; border: none; padding: 13px 20px; font-size: 16px; font-weight: 700; border-radius: 8px; cursor: pointer; width: 100%; margin-top: 10px; transition: background 0.2s; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3); font-family: inherit; }
        button:hover { background-color: var(--green-hover); }
        button:disabled { background-color: #94a3b8; cursor: not-allowed; box-shadow: none; }
        .back-link { display: inline-block; margin-top: 18px; color: #64748b; text-decoration: none; font-size: 14px; text-align: center; width: 100%; font-weight: 500; }
        .back-link:hover { color: var(--primary-navy); text-decoration: underline; }
        .section-tag { font-weight: 700; color: var(--primary-navy); margin: 22px 0 12px 0; border-left: 4px solid var(--sky-blue); padding-left: 10px; font-size: 15px; }
        .upload-status-box { display: none; background: #e0f2fe; border: 1px solid #7dd3fc; color: #0369a1; padding: 12px; border-radius: 8px; margin-top: 15px; font-size: 14px; font-weight: 600; text-align: center; }
    </style>
</head>
<body>

    <div class="form-container">
        <h2>➕ อัปโหลดสื่อการเรียนรู้ใหม่ (คลังสมอง KLANGSAMONG)</h2>
        
        <form id="uploadForm" action="/admin/upload-direct" method="POST">
            
            <div class="section-tag">ข้อมูลสื่อการเรียนรู้</div>

            <div class="form-group">
                <label>หมวดหมู่สื่อ (Category):</label>
                <select name="category" required>
                    <option value="สมุดระบายสีเด็ก">✏️ สมุดระบายสีเด็ก</option>
                    <option value="คณิตศาสตร์">🔢 ชีทคณิตศาสตร์</option>
                    <option value="แบบฝึกหัดคณิตศาสตร์">📐 แบบฝึกหัดคณิตศาสตร์</option>
                    <option value="พื้นฐานการบวกเลข">➕ พื้นฐานการบวกเลข</option>
                    <option value="ชีทฝึกเขียน">✍️ ชีทฝึกเขียนภาษา</option>
                    <option value="แฟลชการ์ด">🎴 แฟลชการ์ด 2 ภาษา</option>
                    <option value="เกมฝึกสมอง">🧩 เกมฝึกสมองเด็ก</option>
                    <option value="นิทานเด็ก AI">📚 นิทานและแบบเรียน</option>
                    <option value="สื่อครูตกแต่ง">🏫 สื่อครูตกแต่งห้องเรียน</option>
                </select>
            </div>

            <div class="form-group">
                <label>ชื่อสื่อการเรียนรู้ / เล่ม (Title):</label>
                <input type="text" name="title" required placeholder="เช่น เล่ม 1 : สัตว์แสนรัก (สมุดระบายสี)">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>ผู้จัดทำ (Author Name):</label>
                    <input type="text" name="author_name" placeholder="คลังสมอง">
                </div>
                <div class="form-group">
                    <label>สำนักพิมพ์ (Publisher):</label>
                    <input type="text" name="publisher" placeholder="คลังสมอง KLANGSAMONG">
                </div>
            </div>

            <div class="form-group">
                <label>รายละเอียด / คำอธิบาย (Description):</label>
                <textarea name="description" placeholder="รายละเอียดเนื้อหาในสื่อการเรียนรู้..."></textarea>
            </div>

            <div class="section-tag">การตั้งราคา & ข้อมูลเพิ่มเติม</div>

            <div class="form-row">
                <div class="form-group">
                    <label>ราคาขายจริง (Price THB):</label>
                    <input type="number" step="0.01" name="price" required placeholder="เช่น 159">
                </div>
                <div class="form-group">
                    <label>ราคาปกติ (Original Price THB - optional):</label>
                    <input type="number" step="0.01" name="original_price" placeholder="เช่น 199">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>ความยาว (Pages / Words):</label>
                    <input type="text" name="pages_count" placeholder="เช่น 20 หน้า">
                </div>
                <div class="form-group">
                    <label>ประเภทไฟล์ (File Format):</label>
                    <input type="text" name="file_type" value="PDF">
                </div>
            </div>

            <div class="form-group">
                <label>ป้ายกำกับพิเศษ (Badge / Tag):</label>
                <input type="text" name="badge" placeholder="เช่น เล่มยอดฮิต, แนะนำ">
            </div>

            <div class="section-tag">☁️ กำหนดไฟล์สื่อ (รองรับลิงก์ Google Drive หรือ เลือกไฟล์จากเครื่อง)</div>

            <div class="form-group">
                <label>📖 ลิงก์ PDF ฉบับเต็ม / Google Drive Link (Full File):</label>
                <input type="text" name="file_path" id="file_path" placeholder="วางลิงก์ Google Drive เช่น https://drive.google.com/file/d/... หรือใช้ปุ่มล่าง">
                <input type="file" id="book_file_input" accept=".pdf" style="margin-top:5px;">
                <small style="color: #0369a1; display: block; margin-top: 4px;">💡 แนะนำวางลิงก์ Google Drive โดยตรงเพื่อความคมชัด 100% และไม่มีข้อจำกัดขนาดไฟล์</small>
            </div>

            <div class="form-group" style="background: #f0fdf4; padding: 14px; border-radius: 8px; border: 1px dashed var(--fresh-green);">
                <label style="color: #15803d;">📄 ลิงก์ PDF ตัวอย่าง / Google Drive Link (Sample Preview PDF):</label>
                <input type="text" name="sample_file_path" id="sample_file_path" placeholder="วางลิงก์ Google Drive หรือเลือกไฟล์ตัวอย่าง">
                <input type="file" id="sample_file_input" accept=".pdf" style="margin-top:5px;">
            </div>

            <div class="form-group">
                <label>🖼️ รูปภาพปกสื่อ (Cover Image URL / File):</label>
                <input type="text" name="cover_image_url" id="cover_image_url" placeholder="วาง URL รูปภาพปก หรือเลือกไฟล์ภาพด้านล่าง">
                <input type="file" id="cover_file_input" accept="image/*" style="margin-top:5px;">
            </div>

            <div class="upload-status-box" id="uploadStatus">
                ⏳ กำลังส่งไฟล์ตรงไปยัง Vercel Storage...
            </div>

            <button type="submit" id="submitBtn">🚀 อัปโหลดสื่อขึ้นระบบ คลังสมอง</button>
        </form>
        <a href="/admin/manage" class="back-link">← กลับไปหน้าระบบจัดการสื่อ</a>
    </div>

    <!-- Import Firebase Storage Direct Uploader -->
    <script type="module" src="/js/firebase-uploader.js"></script>

    <script>
        async function directUploadFile(file, subFolder, statusCallback) {
            if (!file) return '';
            
            // 1. Direct Firebase Storage Upload (Primary method to upload physical files to Firebase CDN)
            if (window.firebaseStorageUpload) {
                try {
                    const firebaseUrl = await window.firebaseStorageUpload(file, subFolder, statusCallback);
                    if (firebaseUrl) {
                        return firebaseUrl;
                    }
                } catch (err) {
                    console.error('Firebase Storage direct upload error:', err);
                    alert('⚠️ ไม่สามารถอัปโหลดไปยัง Firebase Storage ได้!\n\nสาเหตุ: ' + err.message + '\n\n💡 วิธีแก้ไข:\n1. เข้า Firebase Console (https://console.firebase.google.com)\n2. ไปที่เมนู Build -> Storage -> คลิก Get Started\n3. ที่แท็บ Rules ให้ตั้งค่าเป็น:\n   allow read, write: if true;\n4. กด Publish');
                    throw err;
                }
            }

            // 2. Try Client-side Vercel Blob Direct Upload
            if (window.vercelBlobUpload) {
                try {
                    const cleanFileName = file.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                    const blob = await window.vercelBlobUpload(subFolder + '/' + Date.now() + '-' + cleanFileName, file, {
                        access: 'public',
                        handleUploadUrl: '/api/upload/handle-client-upload'
                    });
                    if (blob && blob.url) {
                        return blob.url;
                    }
                } catch (err) {
                    console.warn('Vercel Blob direct upload unconfigured, switching to 2MB Chunked Upload:', err.message);
                }
            }

            // 2. Chunked Upload (2MB chunks -> 100% compliant with Vercel 4.5MB limit without external token!)
            const CHUNK_SIZE = 2 * 1024 * 1024; // 2MB per chunk
            const totalChunks = Math.ceil(file.size / CHUNK_SIZE);
            const uploadId = 'up_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);

            for (let i = 0; i < totalChunks; i++) {
                const start = i * CHUNK_SIZE;
                const end = Math.min(file.size, start + CHUNK_SIZE);
                const chunkBlob = file.slice(start, end);

                const base64Data = await new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => {
                        const res = reader.result;
                        resolve(res.substring(res.indexOf(',') + 1));
                    };
                    reader.onerror = reject;
                    reader.readAsDataURL(chunkBlob);
                });

                const pct = Math.round(((i + 1) / totalChunks) * 100);
                if (statusCallback) statusCallback(pct);

                const res = await fetch('/api/upload-chunk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        uploadId: uploadId,
                        chunkIndex: i,
                        totalChunks: totalChunks,
                        filename: file.name,
                        subFolder: subFolder,
                        mimeType: file.type || 'application/pdf',
                        chunkData: base64Data
                    })
                });

                const resText = await res.text();
                let data;
                try {
                    data = JSON.parse(resText);
                } catch (e) {
                    throw new Error('Chunk upload server error (HTTP ' + res.status + ')');
                }

                if (!data.success) {
                    throw new Error(data.message || 'Chunk upload failed');
                }

                if (data.file_url) {
                    return data.file_url;
                }
            }

            throw new Error('Upload completed without file URL');
        }

        document.getElementById('uploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const submitBtn = document.getElementById('submitBtn');
            const statusBox = document.getElementById('uploadStatus');

            submitBtn.disabled = true;
            statusBox.style.display = 'block';

            try {
                const coverFile = document.getElementById('cover_file_input').files[0];
                const bookFile = document.getElementById('book_file_input').files[0];
                const sampleFile = document.getElementById('sample_file_input').files[0];

                if (coverFile) {
                    statusBox.innerHTML = '⏳ กำลังอัปโหลดรูปภาพปก...';
                    document.getElementById('cover_image_url').value = await directUploadFile(coverFile, 'covers', (pct) => {
                        statusBox.innerHTML = '⏳ กำลังอัปโหลดรูปภาพปก (' + pct + '%)...';
                    });
                }

                if (bookFile) {
                    statusBox.innerHTML = '⏳ กำลังอัปโหลดไฟล์ PDF ฉบับเต็ม...';
                    document.getElementById('file_path').value = await directUploadFile(bookFile, 'books', (pct) => {
                        statusBox.innerHTML = '⏳ กำลังอัปโหลดไฟล์ PDF ฉบับเต็ม (' + pct + '%)...';
                    });
                }

                if (sampleFile) {
                    statusBox.innerHTML = '⏳ กำลังอัปโหลดไฟล์ PDF ตัวอย่าง...';
                    document.getElementById('sample_file_path').value = await directUploadFile(sampleFile, 'samples', (pct) => {
                        statusBox.innerHTML = '⏳ กำลังอัปโหลดไฟล์ PDF ตัวอย่าง (' + pct + '%)...';
                    });
                }

                statusBox.innerHTML = '✅ อัปโหลดไฟล์เรียบร้อยแล้ว กำลังบันทึกข้อมูล...';

                // Send lightweight JSON payload (1KB) - 100% immune to 413 Payload Too Large!
                const payload = {
                    category: this.elements['category'].value,
                    title: this.elements['title'].value,
                    author_name: this.elements['author_name'].value,
                    publisher: this.elements['publisher'].value,
                    description: this.elements['description'].value,
                    price: this.elements['price'].value,
                    original_price: this.elements['original_price'].value,
                    pages_count: this.elements['pages_count'].value,
                    file_type: this.elements['file_type'].value,
                    badge: this.elements['badge'].value,
                    cover_image_url: document.getElementById('cover_image_url').value,
                    file_path: document.getElementById('file_path').value,
                    sample_file_path: document.getElementById('sample_file_path').value
                };

                const res = await fetch('/admin/upload-direct', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    window.location.href = '/admin/manage';
                } else {
                    const errText = await res.text();
                    throw new Error('บันทึกข้อมูลไม่สำเร็จ (HTTP ' + res.status + ')');
                }
            } catch (err) {
                alert('เกิดข้อผิดพลาด: ' + err.message);
                statusBox.style.display = 'none';
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>