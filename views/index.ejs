<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>คลังสมอง KLANGSOMONG - สื่อการเรียนรู้สำหรับเด็ก</title>
    <!-- Google Fonts: Prompt & Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-navy: #1E3A8A;
            --sky-blue: #38BDF8;
            --fresh-green: #22C55E;
            --green-hover: #16a34a;
            --sun-yellow: #FACC15;
            --playful-orange: #FB923C;
            --creative-purple: #8B5CF6;
            --bg-light: #F3F4F6;
            --text-dark: #1E293B;
            --text-muted: #64748B;
        }

        * { box-sizing: border-box; }
        body { font-family: 'Prompt', 'Kanit', sans-serif; margin: 0; background-color: var(--bg-light); color: var(--text-dark); }
        
        /* Top Navigation Header - Deep Navy #1E3A8A */
        header { background-color: var(--primary-navy); color: white; padding: 14px 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2); position: sticky; top: 0; z-index: 100; }
        .logo-container { display: flex; align-items: center; gap: 12px; text-decoration: none; color: white; }
        .brand-logo-img { height: 48px; border-radius: 8px; background: white; padding: 2px; }
        .brand-text-group { display: flex; flex-direction: column; }
        .brand-title { font-size: 22px; font-weight: 700; color: white; letter-spacing: -0.5px; line-height: 1.1; margin: 0; }
        .brand-tagline { font-size: 11px; color: var(--sky-blue); font-weight: 500; margin-top: 2px; }
        
        .header-center { display: flex; flex-direction: column; align-items: center; gap: 6px; flex-grow: 1; max-width: 540px; margin: 0 20px; }
        
        .search-form { width: 100%; display: flex; }
        .search-bar { width: 100%; padding: 9px 16px; border-radius: 20px 0 0 20px; border: none; font-size: 13.5px; outline: none; font-family: inherit; }
        .search-btn { background: var(--fresh-green); border: none; color: white; padding: 0 18px; border-radius: 0 20px 20px 0; cursor: pointer; font-size: 13.5px; font-weight: 600; font-family: inherit; transition: background 0.2s; }
        .search-btn:hover { background: var(--green-hover); }
        
        .user-nav { display: flex; align-items: center; gap: 10px; }
        .btn-header { background: rgba(255,255,255,0.15); color: white; padding: 7px 15px; border-radius: 20px; text-decoration: none; font-size: 13px; font-weight: 600; border: 1px solid rgba(255,255,255,0.3); transition: all 0.2s; cursor: pointer; }
        .btn-header:hover { background: rgba(255,255,255,0.3); transform: translateY(-1px); }
        .btn-admin { background: var(--sun-yellow); color: var(--primary-navy); border: none; font-weight: 700; }
        .btn-admin:hover { background: #eab308; }

        /* Main Container - Full Width Layout */
        .container { max-width: 1280px; margin: 25px auto; padding: 0 20px; }
        
        /* Tiered Pricing Promotion Banner */
        .promo-banner-wrapper { margin-bottom: 25px; }
        .pricing-cards-container { display: flex; gap: 15px; justify-content: center; margin-bottom: 12px; }
        .pricing-card { background: white; border-radius: 12px; border: 1px solid #cbd5e1; padding: 12px 25px; text-align: center; min-width: 180px; box-shadow: 0 2px 6px rgba(0,0,0,0.04); position: relative; }
        .pricing-card.special { border: 2px solid var(--sun-yellow); background: #fefce8; }
        .pricing-badge-tag { position: absolute; top: -10px; right: 15px; background: var(--sun-yellow); color: #713f12; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; }
        .pricing-title { font-size: 12px; color: var(--text-muted); font-weight: 600; margin-bottom: 3px; }
        .pricing-price { font-size: 22px; font-weight: 800; color: var(--primary-navy); }
        .pricing-price small { font-size: 13px; font-weight: 500; color: #64748b; }
        
        .promo-alert-bar { background: #fef08a; border: 1px solid #fde047; color: #854d0e; padding: 9px 15px; border-radius: 20px; font-size: 13px; text-align: center; font-weight: 600; }

        /* Section Header */
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .section-title { font-size: 20px; font-weight: 700; color: var(--primary-navy); border-left: 5px solid var(--sky-blue); padding-left: 12px; margin: 0; display: flex; align-items: center; gap: 8px; }
        .book-count { color: var(--text-muted); font-size: 13.5px; font-weight: 500; }
        
        /* 5-Column Responsive Book Grid */
        .book-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }
        @media (max-width: 1100px) { .book-grid { grid-template-columns: repeat(4, 1fr); } }
        @media (max-width: 850px) { .book-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 600px) { .book-grid { grid-template-columns: repeat(2, 1fr); } }

        .book-card { background: white; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 3px 8px rgba(0,0,0,0.04); padding: 10px; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s; position: relative; }
        .book-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(30, 58, 138, 0.1); border-color: var(--sky-blue); }
        .book-cover-link { cursor: pointer; display: block; }
        .book-cover { width: 100%; height: 215px; object-fit: cover; border-radius: 8px; background: #f1f5f9; }
        .book-info { margin-top: 8px; }
        .category-badge { display: inline-block; background: #e0f2fe; color: #0369a1; font-size: 10.5px; padding: 2px 7px; border-radius: 10px; font-weight: 600; margin-bottom: 4px; }
        .book-title { font-size: 13.5px; font-weight: 600; color: #1e293b; margin: 3px 0; display: -webkit-box; line-clamp: 2; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; height: 35px; cursor: pointer; }
        .book-title:hover { color: var(--primary-navy); }
        
        .page-badge-pill { display: inline-flex; align-items: center; gap: 4px; background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 12px; margin-top: 4px; }
        .book-price { color: #dc2626; font-weight: 800; font-size: 15.5px; margin-top: 4px; }
        
        .card-actions { margin-top: 10px; display: flex; flex-direction: column; gap: 5px; }
        .btn-preview-modal { display: block; width: 100%; text-align: center; padding: 8px 0; background: var(--fresh-green); color: white; border: none; border-radius: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; transition: background 0.2s; font-family: inherit; }
        .btn-preview-modal:hover { background: var(--green-hover); }
        .btn-delete-card { background: #fef2f2; border: 1px solid #fca5a5; color: #ef4444; padding: 5px 0; border-radius: 6px; font-size: 11.5px; font-weight: 600; cursor: pointer; width: 100%; transition: background 0.2s; font-family: inherit; }
        .btn-delete-card:hover { background: #ef4444; color: white; }

        /* Footer */
        footer { background: var(--primary-navy); color: #94a3b8; text-align: center; padding: 20px; font-size: 13px; margin-top: 50px; }
        footer strong { color: white; }

        /* Modals Common Overlay */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); backdrop-filter: blur(3px); z-index: 1000; justify-content: center; align-items: center; padding: 15px; }
        .modal-overlay.active { display: flex; }
        .modal-close { position: absolute; top: 15px; right: 15px; border: none; background: #f1f5f9; font-size: 20px; cursor: pointer; color: #475569; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
        .modal-close:hover { background: #e2e8f0; color: #0f172a; }

        /* Image & Book Preview Modal */
        .preview-modal-box { background: white; border-radius: 16px; width: 100%; max-width: 820px; padding: 30px; box-shadow: 0 20px 40px rgba(0,0,0,0.25); position: relative; max-height: 90vh; overflow-y: auto; }
        .preview-modal-header { border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; padding-right: 40px; }
        .preview-modal-title { font-size: 22px; font-weight: 700; color: var(--primary-navy); margin: 0 0 6px 0; }
        .preview-modal-cat { display: inline-block; background: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 12px; }

        .preview-modal-body { display: flex; gap: 30px; align-items: flex-start; }
        .preview-image-col { width: 320px; flex-shrink: 0; text-align: center; }
        .preview-large-img { width: 100%; max-height: 400px; object-fit: contain; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.12); border: 1px solid #e2e8f0; background: #f8fafc; }
        
        .preview-info-col { flex-grow: 1; }
        .preview-price-tag { font-size: 24px; font-weight: 800; color: #dc2626; margin-bottom: 15px; }
        .preview-price-tag small { font-size: 14px; text-decoration: line-through; color: #94a3b8; font-weight: 500; margin-left: 8px; }
        
        .preview-meta-row { font-size: 14px; margin-bottom: 8px; color: #334155; }
        .preview-meta-row strong { color: #0f172a; }
        .preview-description { background: #f8fafc; border-radius: 10px; padding: 14px; margin: 15px 0; font-size: 13.5px; line-height: 1.7; color: #334155; border: 1px solid #e2e8f0; white-space: pre-line; max-height: 140px; overflow-y: auto; }
        
        .preview-actions-group { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
        .btn-modal-sample { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 20px; border: 2px solid var(--fresh-green); color: var(--fresh-green); background: white; border-radius: 25px; text-decoration: none; font-size: 14.5px; font-weight: 700; transition: all 0.2s; }
        .btn-modal-sample:hover { background: #dcfce7; }
        
        .btn-modal-download { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 11px 20px; background: var(--fresh-green); color: white; border-radius: 25px; text-decoration: none; font-size: 14.5px; font-weight: 700; border: none; cursor: pointer; transition: background 0.2s; box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3); }
        .btn-modal-download:hover { background: var(--green-hover); }

        .btn-modal-fullpage { text-align: center; color: var(--primary-navy); font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 4px; }
        .btn-modal-fullpage:hover { text-decoration: underline; }

        /* Login Modal */
        .login-modal-box { background: white; border-radius: 14px; width: 100%; max-width: 400px; padding: 25px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); position: relative; }
        .login-modal-title { font-size: 20px; font-weight: bold; margin-bottom: 20px; color: var(--primary-navy); text-align: center; }
        .form-field { margin-bottom: 15px; }
        .form-field label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 5px; color: #555; }
        .form-field input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; font-family: inherit; }
        .btn-submit { width: 100%; background: var(--fresh-green); color: white; border: none; padding: 12px; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; font-family: inherit; }
        .btn-submit:hover { background: var(--green-hover); }
        .quick-credentials { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 12px; margin-top: 15px; font-size: 12px; }
        .quick-credentials button { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; border-radius: 4px; padding: 4px 8px; margin-top: 4px; cursor: pointer; font-size: 11px; font-weight: bold; }

        .no-books { background: white; padding: 40px; text-align: center; border-radius: 12px; color: #777; font-size: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }

        @media (max-width: 700px) {
            .preview-modal-body { flex-direction: column; align-items: center; }
            .preview-image-col { width: 100%; }
        }
    </style>
</head>
<body>

    <!-- Header Navigation Bar -->
    <header>
        <a href="/" class="logo-container">
            <img src="/images/logo.png" alt="คลังสมอง KLANGSOMONG" class="brand-logo-img" onerror="this.style.display='none';">
            <div class="brand-text-group">
                <h1 class="brand-title">คลังสมอง</h1>
                <span class="brand-tagline">KLANGSOMONG — เรียนวันนี้ เก่งได้ทุกวัน —</span>
            </div>
        </a>

        <div class="header-center">
            <form action="/" method="GET" class="search-form">
                <input type="text" name="q" class="search-bar" placeholder="ค้นหาสื่อการเรียนรู้, สมุดระบายสี, ใบงาน..." value="<%= searchQuery %>">
                <button type="submit" class="search-btn">🔍 ค้นหา</button>
            </form>
        </div>

        <div class="user-nav">
            <% if (currentUser) { %>
                <span style="font-size: 13px;">
                    <% if (currentUser.role === 'admin') { %>
                        👑 <strong><%= currentUser.username %></strong> <small>(Admin)</small>
                    <% } else { %>
                        👤 <strong><%= currentUser.username %></strong>
                    <% } %>
                </span>

                <% if (currentUser.role === 'admin') { %>
                    <a href="/admin/manage" class="btn-header btn-admin">⚙️ จัดการสื่อ</a>
                <% } %>

                <a href="/logout" class="btn-header">ออกจากระบบ</a>
            <% } else { %>
                <button class="btn-header" onclick="openLoginModal()">🔑 เข้าสู่ระบบ</button>
            <% } %>
        </div>
    </header>

    <!-- Main Container (Full Width) -->
    <div class="container">
        
        <!-- Tiered Volume Pricing Promotion Banner -->
        <div class="promo-banner-wrapper">
            <div class="pricing-cards-container">
                <div class="pricing-card">
                    <div class="pricing-title">ซื้อ 1 - 29 เล่ม</div>
                    <div class="pricing-price">159 <small>บาท/เล่ม</small></div>
                </div>
                <div class="pricing-card special">
                    <div class="pricing-badge-tag">พิเศษ</div>
                    <div class="pricing-title">ซื้อ 30 - 50 เล่ม</div>
                    <div class="pricing-price">199 <small>บาท/ชุด</small></div>
                </div>
            </div>
            <div class="promo-alert-bar">
                ⚠️ สั่งซื้อขั้นต่ำ 10 เล่มขึ้นไป / คละแบบได้ 20 หน้าขึ้นไป หรือดาวน์โหลดไฟล์ PDF เข้าเรียนได้ทันที
            </div>
        </div>

        <!-- Section Header -->
        <div class="section-header">
            <h2 class="section-title">
                <span>🧠</span>
                <span>สื่อการเรียนรู้ทั้งหมด</span>
                <% if (searchQuery) { %>
                    <span style="font-size: 14px; color: var(--text-muted); font-weight: normal;">(ค้นหา "<%= searchQuery %>")</span>
                <% } %>
            </h2>
            <span class="book-count">พบ <%= books.length %> รายการ</span>
        </div>

        <!-- 5-Column Book & Worksheet Grid -->
        <% if (books.length > 0) { %>
            <div class="book-grid">
                <% books.forEach(book => { %>
                    <div class="book-card">
                        <div class="book-cover-link" onclick="openPreviewModal(<%= JSON.stringify(book) %>)">
                            <img src="<%= book.cover_image_url || 'https://via.placeholder.com/200x250?text=No+Cover' %>" alt="<%= book.title %>" class="book-cover">
                        </div>
                        <div class="book-info">
                            <span class="category-badge"><%= book.category || 'สมุดระบายสีเด็ก' %></span>
                            <div class="book-title" onclick="openPreviewModal(<%= JSON.stringify(book) %>)" title="<%= book.title %>"><%= book.title %></div>
                            <div class="page-badge-pill">
                                <span>🟢</span>
                                <span><%= book.pages_count || '20 หน้า' %></span>
                            </div>
                            <div class="book-price">฿<%= parseFloat(book.price).toFixed(0) %></div>
                        </div>
                        <div class="card-actions">
                            <!-- Click opens Preview Popup Modal -->
                            <button class="btn-preview-modal" onclick="openPreviewModal(<%= JSON.stringify(book) %>)">📖 ดูรายละเอียด / อ่าน PDF</button>

                            <% if (currentUser && currentUser.role === 'admin') { %>
                                <form action="/admin/delete-book/<%= book.id %>" method="POST" onsubmit="return confirm('คุณต้องการลบสื่อรายการนี้ใช่หรือไม่?');" style="margin-top:2px;">
                                    <button type="submit" class="btn-delete-card">🗑️ ลบ</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="no-books">
                <p>📭 ยังไม่มีรายการสื่อการเรียนรู้ในระบบ</p>
                <% if (currentUser && currentUser.role === 'admin') { %>
                    <a href="/admin/upload" style="color: var(--fresh-green); font-weight: bold; text-decoration: none;">+ เพิ่มรายการใหม่</a>
                <% } %>
            </div>
        <% } %>

    </div>

    <!-- Image & Book Preview Popup Modal -->
    <div class="modal-overlay" id="previewModal">
        <div class="preview-modal-box">
            <button class="modal-close" onclick="closePreviewModal()">&times;</button>
            
            <div class="preview-modal-header">
                <div class="preview-modal-cat" id="prevCat">สมุดระบายสีเด็ก</div>
                <h3 class="preview-modal-title" id="prevTitle">ชื่อสื่อการเรียนรู้</h3>
            </div>

            <div class="preview-modal-body">
                <!-- Left Image Column -->
                <div class="preview-image-col">
                    <img id="prevImg" src="" alt="Preview Image" class="preview-large-img">
                </div>

                <!-- Right Info & Download Column -->
                <div class="preview-info-col">
                    <div class="preview-price-tag">
                        ฿<span id="prevPrice">159</span>
                        <small id="prevOrigPriceContainer" style="display:none;">฿<span id="prevOrigPrice">199</span></small>
                    </div>

                    <div class="preview-meta-row">ผู้จัดทำ: <strong id="prevAuthor">คลังสมอง</strong></div>
                    <div class="preview-meta-row">สำนักพิมพ์: <strong id="prevPublisher">คลังสมอง KLANGSOMONG</strong></div>
                    <div class="preview-meta-row">ความยาว: <strong id="prevPages">20 หน้า</strong></div>
                    <div class="preview-meta-row">ประเภทไฟล์: <strong id="prevType">PDF</strong></div>

                    <div class="preview-description" id="prevDesc">รายละเอียดสื่อ...</div>

                    <div class="preview-actions-group">
                        <a href="#" id="prevSampleBtn" target="_blank" class="btn-modal-sample" style="display:none;">
                            👁️ อ่าน / ดูตัวอย่าง PDF
                        </a>

                        <button id="prevDownloadBtn" class="btn-modal-download">
                            📥 ดาวน์โหลด PDF ฉบับเต็ม
                        </button>

                        <a href="#" id="prevSubpageLink" class="btn-modal-fullpage">
                            🔗 ดูรายละเอียดเพิ่มเติม (หน้าซับเพจเต็ม)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Login Modal -->
    <div class="modal-overlay" id="loginModal">
        <div class="login-modal-box">
            <button class="modal-close" onclick="closeLoginModal()">&times;</button>
            <div class="login-modal-title">เข้าสู่ระบบ (Login)</div>
            
            <% if (loginError) { %>
                <div style="background:#fff2f0; border:1px solid #ffccc7; color:#ff4d4f; padding:8px; border-radius:6px; font-size:13px; margin-bottom:15px; text-align:center;">
                    ⚠️ ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="form-field">
                    <label>ชื่อผู้ใช้งาน (Username):</label>
                    <input type="text" name="username" id="loginUsername" required placeholder="กรอก username">
                </div>
                <div class="form-field">
                    <label>รหัสผ่าน (Password):</label>
                    <input type="password" name="password" id="loginPassword" required placeholder="กรอก password">
                </div>
                <button type="submit" class="btn-submit">เข้าสู่ระบบ</button>
            </form>

            <div class="quick-credentials">
                <strong>💡 ข้อมูลเข้าสู่ระบบทดสอบ (Demo Accounts):</strong><br>
                • <strong>User:</strong> username: <code>user</code> | password: <code>user123</code>
                <button onclick="fillLogin('user', 'user123')">เติมข้อมูล User</button><br>
                • <strong>Admin:</strong> username: <code>admin</code> | password: <code>admin123</code>
                <button onclick="fillLogin('admin', 'admin123')">เติมข้อมูล Admin</button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p><strong>© คลังสมอง KLANGSOMONG</strong> — สื่อการเรียนรู้ที่เข้าใจง่าย สนุก และใช้ได้จริง "เรียนรู้ เข้าใจ ใช้ได้จริง"</p>
    </footer>

    <script>
        const currentUser = JSON.parse('<%- JSON.stringify(currentUser || null) %>');

        function openPreviewModal(book) {
            document.getElementById('prevTitle').textContent = book.title;
            document.getElementById('prevCat').textContent = book.category || 'สมุดระบายสีเด็ก';
            document.getElementById('prevImg').src = book.cover_image_url || 'https://via.placeholder.com/300x400?text=No+Cover';
            document.getElementById('prevPrice').textContent = parseFloat(book.price).toFixed(0);
            
            if (book.original_price && book.original_price > book.price) {
                document.getElementById('prevOrigPrice').textContent = parseFloat(book.original_price).toFixed(0);
                document.getElementById('prevOrigPriceContainer').style.display = 'inline';
            } else {
                document.getElementById('prevOrigPriceContainer').style.display = 'none';
            }

            document.getElementById('prevAuthor').textContent = book.author_name || 'คลังสมอง';
            document.getElementById('prevPublisher').textContent = book.publisher || 'คลังสมอง KLANGSOMONG';
            document.getElementById('prevPages').textContent = book.pages_count || '20 หน้า';
            document.getElementById('prevType').textContent = book.file_type || 'PDF';
            document.getElementById('prevDesc').textContent = book.description || 'ไม่มีรายละเอียดเพิ่มเติมสำหรับสื่อรายการนี้';
            
            document.getElementById('prevSubpageLink').href = '/book/' + book.id;

            // Sample PDF Preview Button
            const sampleBtn = document.getElementById('prevSampleBtn');
            if (book.sample_file_path) {
                sampleBtn.href = book.sample_file_path;
                sampleBtn.style.display = 'inline-flex';
            } else {
                sampleBtn.style.display = 'none';
            }

            // Full Download PDF Button (Login-Gated)
            const downloadBtn = document.getElementById('prevDownloadBtn');
            downloadBtn.onclick = function() {
                if (!currentUser) {
                    closePreviewModal();
                    openLoginModal();
                } else {
                    if (book.file_path) {
                        const a = document.createElement('a');
                        a.href = book.file_path;
                        a.download = book.title + '.pdf';
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                    } else {
                        alert('ไฟล์ PDF ฉบับเต็มยังไม่ได้ถูกอัปโหลดสำหรับรายการนี้');
                    }
                }
            };

            document.getElementById('previewModal').classList.add('active');
        }

        function closePreviewModal() {
            document.getElementById('previewModal').classList.remove('active');
        }

        function openLoginModal() {
            document.getElementById('loginModal').classList.add('active');
        }
        function closeLoginModal() {
            document.getElementById('loginModal').classList.remove('active');
        }
        function fillLogin(u, p) {
            document.getElementById('loginUsername').value = u;
            document.getElementById('loginPassword').value = p;
        }

        // Close modals on escape key or clicking backdrop
        window.onclick = function(event) {
            const prevModal = document.getElementById('previewModal');
            const loginModal = document.getElementById('loginModal');
            if (event.target === prevModal) closePreviewModal();
            if (event.target === loginModal) closeLoginModal();
        };

        const loginError = JSON.parse('<%- JSON.stringify(Boolean(typeof loginError !== "undefined" && loginError)) %>');
        if (loginError) {
            openLoginModal();
        }
    </script>
</body>
</html>